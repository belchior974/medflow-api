{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "MedFlow": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "//": "Vazio = sem Redis. O cache degrada para L1 e a aplicacao continua funcionando.",
    "Redis": "localhost:6379"
  },

  "OpenTelemetry": {
    "ZipkinEndpoint": "http://localhost:9411/api/v2/spans"
  },

  "MedFlow": {
    "Agenda": {
      "HoraInicio": 8,
      "HoraFim": 18,
      "DuracaoConsultaMinutos": 30,
      "AntecedenciaMinimaHoras": 1
    },
    "Cache": {
      "L1TtlSegundos": 30,
      "L1TamanhoMaximo": 10000,
      "L2TtlSegundos": 300
    },
    "Convenio": {
      "BaseUrl": "http://localhost:8089",
      "TimeoutMs": 2000,
      "MaxTentativas": 3,
      "DelayInicialMs": 300,
      "LimiarDeFalha": 0.5,
      "ChamadasMinimas": 5,
      "JanelaAmostragemSegundos": 30,
      "DuracaoCircuitoAbertoSegundos": 10,
      "MaxChamadasConcorrentes": 20
    },
    "Banco": {
      "//": "sqlite roda sem nenhuma infra. O docker-compose sobrescreve para postgres.",
      "Provider": "sqlite",
      "ConnectionString": "Data Source=medflow.db",
      "AutoInicializarSchema": true
    }
  }
}
